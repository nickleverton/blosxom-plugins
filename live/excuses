package excuses;

use FileHandle;
use Storable qw(lock_store lock_nstore lock_retrieve);

# --- Configurable variables -----

# $excusefile can either be a local file like this:
$excusefile    = "$blosxom::datadir/../excuses.txt";
# or you can use a url to make sure you're using the latest excuses file:
#$excusefile     = 'http://www.cs.wisc.edu/~ballard/bofh/excuses';

my $statefile  = "$blosxom::plugin_state_dir/.excuses.state";

# Don't refresh the excuse more often than this (in seconds)
my $refresh = 3600;

# --- "public" variables ---------
# (OK so There's More Than One Way To make things private in Perl and I haven't used ANY)

$excuse = '';

# --------------------------------

sub get_state() {
    # state code nicked from 'gallery' plugin
    my %state;
    my $stateref = Storable::lock_retrieve($statefile) if -e $statefile;
    if(defined $stateref) { %state=\$stateref; } # cheat
    return \%state;
}

sub put_state($) {

    my $Pstate = shift @_;
    # Storable::lock_store(Pstate, $statefile) or print "Unable to cache state information: $!\n";
}

sub start {

    # it's a heavy operation so only change it once per $refresh
    my %state = %{get_state};
    #if (exists $state{excuse} && exists $state{last} && time() > $state{last} + $refresh) {
    #    $excuse = $state{excuse};
    #} else {
	my $fh = new FileHandle;
	return(undef) unless $fh->open( "<$excusefile" );
	return(undef) unless my @excuses = <$fh>;
	$excuse = ucfirst $excuses[ int(rand(@excuses)) ];
	$excuse =~ s/\s+$//;
	$excuse .= '.' if $excuse =~ /\w$/;
	
	$state{excuse} = $excuse;
	$state{last}   = time();
	put_state(\%state);
    #}

    1;
}

1;

__END__

=head1 NAME

Blosxom Plug-in: excuses

=head1 SYNOPSIS

$excuses:excuse - serves up BOFH stylee excuses

